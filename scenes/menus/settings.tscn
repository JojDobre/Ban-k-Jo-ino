[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/menus/settings.gd" id="1_settings"]
[ext_resource type="PackedScene" path="res://scenes/menus/menu_background.tscn" id="2_bg"]
[ext_resource type="Texture2D" path="res://assets/icons/arrowLeft.png" id="3_back"]

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Background" parent="." instance=ExtResource("2_bg")]
layout_mode = 1

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(620, 0)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 46
text = "Nastavenia"
horizontal_alignment = 1

[node name="MusicLabel" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Hudba"

[node name="MusicSlider" type="HSlider" parent="Center/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
max_value = 1.0
step = 0.05

[node name="SfxLabel" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Zvuky"

[node name="SfxSlider" type="HSlider" parent="Center/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
max_value = 1.0
step = 0.05

[node name="FastMine" type="CheckButton" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Ladenie: rýchla baňa (1 h = 1 min)"

[node name="ResetButton" type="Button" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
