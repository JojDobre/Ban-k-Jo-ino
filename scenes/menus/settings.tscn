[node name="Center" type="CenterContainer" parent="Confirm"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Confirm/Center"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Confirm/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Question" type="Label" parent="Confirm/Center/Panel/VBox"]
layout_mode = 2
text = "Naozaj vymazať celý postup?
Mince, zlato, levely aj dedina sa stratia."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Confirm/Center/Panel/VBox"]
layout_mode = 2
