; Engine configuration file.

config_version=5

[application]

config/name="Jožino – Dobrodružstvo"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
EconomyManager="*res://autoload/economy_manager.gd"
ProgressionManager="*res://autoload/progression_manager.gd"
Audio="*res://autoload/audio.gd"
Music="*res://autoload/music.gd"
VillageManager="*res://autoload/village_manager.gd"
ShopManager="*res://autoload/shop_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/ui/theme.tres"

